<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.TableChips">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The table must keep running with the screen off and the app in the
          background, so the server lives in a foreground service.

          There is no standard foregroundServiceType for "this phone is the
          server of a game in the room": it is not media playback, not a
          location fix, not a data sync with a remote backend. specialUse is the
          honest answer, and the subtype below is the justification Google asks
          for at review time.
        -->
        <service
            android:name=".HostService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android:PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="@string/fgs_special_use_justification" />
        </service>

        <!--
          The intent filters that let a scanned link open the app (the custom
          tablechips:// scheme and a non-verified http filter) arrive with the
          link bridge. See docs/deeplinks.md for why they cannot be verified
          App Links.
        -->
    </application>
</manifest>
