<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the phone. A table is a local, short-lived thing and there is
  no account to restore it into, so neither cloud backup nor device transfer
  takes anything with it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
